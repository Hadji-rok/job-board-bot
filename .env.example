# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
# Optional: set for instant command registration in one server during dev.
# Leave blank to register commands globally (takes up to 1hr to propagate).
DISCORD_GUILD_ID=

# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/job_board_bot?schema=public"

# How often (ms) the bot checks for expired jobs
EXPIRY_CHECK_INTERVAL_MS=60000
